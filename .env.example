# Copy to deploy/.env on the Mac mini. Never commit the real file.
PORT=3001
DATA_FILE=/data/lingo-loop.sqlite

# Exact Vercel production origin. Add preview origins only while testing.
CORS_ORIGIN=https://englishlearning-phi.vercel.app

# Set both keys on the Mac mini to enable live speaking. Never use VITE_ for keys.
SPEAKING_PROVIDER=live
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MONTHLY_AI_TURN_LIMIT=600
MONTHLY_AI_BUDGET_KRW=4500
USD_KRW_RATE=1500
ANTHROPIC_INPUT_USD_PER_M=1
ANTHROPIC_OUTPUT_USD_PER_M=5
OPENAI_STT_USD_PER_MIN=0.003
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web build variable configured in Vercel, not in this server container:
# VITE_API_BASE_URL=https://YOUR-MAC-NAME.YOUR-TAILNET.ts.net
